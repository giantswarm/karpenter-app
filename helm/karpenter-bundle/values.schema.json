{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "clusterID": {
            "type": "string"
        },
        "helmRelease": {
            "type": "object",
            "properties": {
                "dependsOn": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nodeIamRole": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Create the IAM role and instance profile for karpenter-launched nodes. Required on EKS clusters, where no worker instance profile exists."
                }
            }
        },
        "ociRepositoryUrl": {
            "type": "string"
        },
        "region": {
            "type": "string"
        },
        "workersIamRole": {
            "type": "string"
        }
    }
}
